# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_keep_secret

# GitHub OAuth Configuration
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# Google OAuth Configuration (Google Identity Services & Standalone OAuth)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_optional_for_server_flow

# Application Base URL (for decoupled background workers)
NEXT_PUBLIC_APP_URL=https://your-production-domain.vercel.app

# GitHub API Access Token Pool (Rotate up to 5 PATs to achieve up to 25,000 req/hr throughput)
GITHUB_ACCESS_TOKEN=your_primary_github_personal_access_token
GITHUB_ACCESS_TOKEN_1=your_first_github_personal_access_token
GITHUB_ACCESS_TOKEN_2=your_second_github_personal_access_token
GITHUB_ACCESS_TOKEN_3=your_third_github_personal_access_token
GITHUB_ACCESS_TOKEN_4=your_fourth_github_personal_access_token
GITHUB_ACCESS_TOKEN_5=your_fifth_github_personal_access_token

# Admin Portal Credentials
ADMIN_PORTAL_EMAIL=your_admin_email@example.com
ADMIN_PORTAL_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=generate_a_random_32_char_secret_for_admin_hmac

# Cron Job & Background Worker Secret (for /api/cron/* and /api/sync/background)
CRON_SECRET=your_cron_secret_key
